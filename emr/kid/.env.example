# ---- Browser (Firebase web SDK). Defaults in lib/firebase-init.js point at clinci-dr-gunda.
VITE_KID_FIREBASE_API_KEY=your-api-key
VITE_KID_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_KID_FIREBASE_PROJECT_ID=your-project-id
VITE_KID_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_KID_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_KID_FIREBASE_APP_ID=your-app-id
VITE_KID_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ---- Clinic login (staff password gate)
CLINIC_ACCESS_PASSWORD=change-this-password
CLINIC_SESSION_SECRET=replace-with-a-long-random-secret

# ---- Server-side Firebase Admin (api/kid/*)
# Locally: path to the service-account JSON (relative to this folder is fine).
GOOGLE_APPLICATION_CREDENTIALS=../../secrets/firebase-service-account.json
# On Vercel: paste the service-account JSON (or base64 of it) instead.
# KID_FIREBASE_SERVICE_ACCOUNT_KEY=
KID_FIREBASE_PROJECT_ID=clinci-dr-gunda
KID_FIREBASE_STORAGE_BUCKET=clinci-dr-gunda.firebasestorage.app

# ---- Parent portal OTP (MSG91) + patient session
MSG91_AUTH_KEY=
MSG91_EXISTENCE_CHECK_SECRET=
PATIENT_SESSION_SECRET=replace-with-another-long-random-secret

# ---- Optional: lungs app lookup used by the OTP user-exists check
# LUNGS_FIREBASE_SERVICE_ACCOUNT_KEY=
# LUNGS_FIREBASE_PROJECT_ID=
# LUNGS_FIREBASE_STORAGE_BUCKET=
